# ── Baza podataka ────────────────────────────────────────────────────
# Aktivni provider (informativno; stvarni provider je fiksiran u
# backend/prisma/schema.prisma i ne mijenja se ovim flagom sam od sebe —
# vidi docs/mysql-to-postgres-migration.md, sekcija "DB_PROVIDER flag").
DB_PROVIDER=postgres

# DATABASE_URL koji koriste: Prisma CLI sa host mašine (migrate/generate/
# seed van kontejnera), build-arg za `prisma generate` u Dockerfile-u, i
# svaki alat kojem treba direktan pristup bazi izvana.
# NAPOMENA: unutar Docker Compose-a (produkcija), backend servis NE
# koristi ovu vrijednost za konekciju u runtime-u — tamo se DATABASE_URL
# eksplicitno prepisuje na host "postgres" (naziv servisa na Docker mreži
# "web"), vidi docker-compose.yml. Ova varijabla ovdje služi za pristup
# spolja, preko javnog hosta.
DATABASE_URL=postgresql://fkgracanica:Mojalozinka!1@sql.ba101.top:5432/fkgracanica

# Pojedinačne komponente konekcije — koristi ih docker-compose.yml da
# unutar Docker mreže sastavi DATABASE_URL sa host="postgres" umjesto
# javnog sql.ba101.top hosta.
POSTGRES_USER=fkgracanica
POSTGRES_PASSWORD=Mojalozinka!1
POSTGRES_DB=fkgracanica

# ── MySQL (BACKUP — trenutno neaktivno) ─────────────────────────────
# Originalna MySQL konekcija je ostavljena ovdje samo kao referenca/
# rollback materijal. Aplikacija je trenutno u potpunosti prešla na
# Postgres (schema.prisma provider = postgresql, adapter = @prisma/adapter-pg).
# Da bi se ovo ponovo koristilo, potrebno je vratiti fajlove iz
# backend/prisma-mysql-backup/ (vidi README u tom folderu) i onda
# DATABASE_URL_MYSQL_BACKUP staviti u DATABASE_URL.
# DATABASE_URL_MYSQL_BACKUP=mysql://USER:PASSWORD@sql.ba101.top:3306/fkgracanica

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
REDIS_URL=redis://redis:6379
UPLOAD_PATH=/app/uploads
CORS_ORIGINS=https://fkgracanica.ba101.top
PORT=3000
API_PUBLIC_URL=https://fkgracanica.ba101.top/backend
SOCKET_IO_PATH=/socket.io
ADMIN_EMAIL=admin@fkgracanica.ba
ADMIN_PASSWORD=change-me
VITE_API_URL=https://fkgracanica.ba101.top/backend/api/v1
# Frontend OG server (Docker) — interni poziv prema backendu
INTERNAL_API_URL=http://backend:3000/api/v1
VITE_REALTIME_URL=https://fkgracanica.ba101.top/realtime
VITE_SOCKET_IO_PATH=/backend/socket.io
EXPO_PUBLIC_API_URL=https://fkgracanica.ba101.top/backend/api/v1
EXPO_PUBLIC_REALTIME_URL=https://fkgracanica.ba101.top/realtime
EXPO_PUBLIC_SOCKET_IO_PATH=/backend/socket.io
