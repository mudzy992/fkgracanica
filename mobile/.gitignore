# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# iOS Firebase plist (keep out of git; Android google-services.json
# must be available to EAS local pack — treat as client config)
GoogleService-Info.plist

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local EAS artifacts
*.apk
*.aab
