# Database (MySQL na hostu)
DATABASE_URL=mysql://mudzy:nije,kikiriki@sql.ba101.top:3306/fkgracanica

# JWT
JWT_ACCESS_SECRET=fkgracanica-dev-access-secret-change-in-prod
JWT_REFRESH_SECRET=fkgracanica-dev-refresh-secret-change-in-prod
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Redis (docker service name u compose)
REDIS_URL=redis://redis:6379

# Upload (bind mount u kontejneru)
UPLOAD_PATH=/app/uploads

# CORS
CORS_ORIGINS=https://fkgracanica.ba101.top,http://localhost:5173

# Backend
PORT=3000
API_PUBLIC_URL=https://fkgracanica.ba101.top/backend
SOCKET_IO_PATH=/backend/socket.io

# Seed admin
ADMIN_EMAIL=admin@fkgracanica.ba
ADMIN_PASSWORD=Admin123!

# Frontend build (docker build arg + lokalni dev)
VITE_API_URL=https://fkgracanica.ba101.top/backend/api/v1

# Mobile
EXPO_PUBLIC_API_URL=https://fkgracanica.ba101.top/backend/api/v1
