{
  "name": "fkgracanica",
  "private": true,
  "workspaces": ["backend", "frontend", "mobile"],
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4"
  },
  "scripts": {
    "dev:backend": "npm run start:dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:mobile": "npm run start -w mobile",
    "build": "npm run build -w backend && npm run build -w frontend",
    "db:migrate": "npm run prisma:migrate -w backend",
    "db:seed": "npm run prisma:seed -w backend",
    "db:generate": "npm run prisma:generate -w backend"
  }
}
